# ==============================================================================
# Tether Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Database Configuration (Supabase PostgreSQL with pgmq extension)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Supabase Auth & Edge Ingest
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
WEBHOOK_SECRET=your-webhook-hmac-secret-key

# Queue Configuration
QUEUE_NAME=agent_runs
DLQ_NAME=agent_runs_dlq
VISIBILITY_TIMEOUT_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=20
MAX_ATTEMPTS=5

# LLM Runtime & LiteLLM Configuration
DEFAULT_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-3-5-haiku-20241022
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
STEP_TIMEOUT_SECONDS=45

# Review Gate & Notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
REVIEW_PORTAL_URL=http://localhost:3000/review
APPROVAL_EXPIRY_SECONDS=86400

# BigQuery Warehouse & Outbox Exporter
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=tether_analytics
BIGQUERY_EVENTS_TABLE=events
EXPORT_BATCH_SIZE=500
EXPORT_INTERVAL_SECONDS=10
